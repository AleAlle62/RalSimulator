# Il backend e il frontend hanno ognuno il proprio .gitignore.
# Qui sta solo ciò che riguarda la radice o entrambi.

.DS_Store
.idea
*.sw?
*.log
.vite/
node_modules/

# La SPA compilata finisce dentro backend/public: è un artefatto di build,
# si rigenera con `pnpm build` e non va versionata.
# Non c'è collisione con Laravel: lì stanno index.php e gli asset di Filament
# sotto css/filament, js/filament e fonts/filament; Quasar scrive index.html,
# assets/ e icons/ — e solo quelli, vedi frontend/scripts/copy-to-laravel.mjs.
backend/public/index.html
backend/public/assets/
backend/public/icons/
