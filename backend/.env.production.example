# Variabili d'ambiente per la produzione su Laravel Cloud.
#
# Questo file non viene letto da nessuno: è il riferimento da cui copiare i valori nella
# sezione "Environment variables" dell'ambiente, che Cloud inietta nel container a ogni
# deploy. Qui c'è solo ciò che cambia rispetto a .env.example — tutto il resto (APP_LOCALE,
# BCRYPT_ROUNDS, i default di mail e broadcast) va bene com'è.

APP_NAME="RAL Simulator"
APP_ENV=production

# Si genera una volta sola con `php artisan key:generate --show` e si incolla qui.
# Cambiarla dopo il primo deploy invalida ogni sessione già aperta e rende illeggibile
# qualunque valore cifrato con la chiave precedente.
APP_KEY=

# Con il debug attivo una qualsiasi eccezione restituisce lo stack trace, e con esso i
# valori delle variabili d'ambiente — credenziali del database comprese. Resta false.
APP_DEBUG=false

# Il dominio pubblico, con https. Lo legge anche Sanctum: config/sanctum.php lo passa a
# currentApplicationUrlWithPort() per riconoscere le richieste che possono usare la sessione.
APP_URL=https://esempio.laravel.cloud

# Log su stderr, non su file: il filesystem del container è effimero e storage/logs
# sparirebbe a ogni redeploy. Cloud raccoglie stderr e lo mostra nella sezione "Logs".
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# SQLite qui non è un'opzione: è un file su disco effimero, e al primo redeploy sparirebbero
# tutte le simulazioni salvate — cioè ogni link già condiviso, che è esattamente la promessa
# che lo snapshot in `simulations.result` esiste per mantenere.
#
# Si crea un database dal dashboard e lo si collega all'ambiente: DB_HOST, DB_PORT,
# DB_DATABASE, DB_USERNAME e DB_PASSWORD li inietta Cloud da sé. Non vanno scritti qui.
#
# MySQL o Postgres è indifferente per questa applicazione: nessuna migration usa SQL raw, e
# l'unica colonna json (simulations.result) viene sempre scritta e letta intera, mai
# interrogata con whereJson. Cambia solo il valore qui sotto: mysql oppure pgsql.
DB_CONNECTION=mysql

# Sessioni, cache e code stanno già tutte sul database: non serve aggiungere Redis.
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# Il cookie di sessione viaggia solo su https. Senza questo verrebbe emesso anche in chiaro,
# ed è il cookie con cui si è autenticati.
SESSION_SECURE_COOKIE=true

# SANCTUM_STATEFUL_DOMAINS non serve: config/sanctum.php include currentRequestHost(), quindi
# il dominio che ha servito la richiesta è già stateful — vale per il dominio .laravel.cloud
# e per un dominio custom, senza toccare niente.
